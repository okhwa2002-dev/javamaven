#!/usr/bin/env bash
#
# main / master 브랜치에 직접 push 하는 것을 차단한다.
# .claude/rules/git.md 의 브랜치 정책 준수를 위한 로컬 세이프티넷.
#
# 우회가 꼭 필요할 때: ALLOW_MAIN_PUSH=1 git push
#

protected_branches="main master"

if [ "$ALLOW_MAIN_PUSH" = "1" ]; then
    exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    remote_branch="${remote_ref##refs/heads/}"
    for protected in $protected_branches; do
        if [ "$remote_branch" = "$protected" ]; then
            echo "==================================================================="
            echo " Blocked: '$remote_branch' 는 보호된 브랜치입니다."
            echo ""
            echo "  1) feature/ 또는 fix/ 브랜치를 만들어 push 하세요:"
            echo "       git switch -c feature/<이슈번호>-<간단설명>"
            echo "       git push -u origin feature/<이슈번호>-<간단설명>"
            echo ""
            echo "  2) 정말 우회가 필요하면 (권장하지 않음):"
            echo "       ALLOW_MAIN_PUSH=1 git push"
            echo "==================================================================="
            exit 1
        fi
    done
done

exit 0
