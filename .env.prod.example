# prod 프로파일용 환경변수 템플릿.
# 이 파일을 .env.prod로 복사한 뒤 실제 값을 채워 사용하세요.
#   cp .env.prod.example .env.prod
# .env.prod 는 절대 커밋 금지 (.gitignore에 등록됨).
#
# 실행: java -jar app.jar --spring.profiles.active=prod -Ddotenv.filename=.env.prod
# 운영 서버에서는 .env.prod 파일 대신 OS 환경변수/시크릿 매니저로 주입 권장.

# --- Database (PostgreSQL, 운영) ---
DB_URL=jdbc:postgresql://prod-db.internal:5432/daily?sslmode=require
DB_USERNAME=daily_prod_user
DB_PASSWORD=여기에실제운영비밀번호

# --- CORS ---
# 콤마 구분, 프로토콜 포함, 트레일링 슬래시 없이
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
