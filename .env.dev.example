# dev 프로파일용 환경변수 템플릿.
# 이 파일을 .env.dev로 복사한 뒤 실제 값을 채워 사용하세요.
#   cp .env.dev.example .env.dev
# .env.dev 는 절대 커밋 금지 (.gitignore에 등록됨).
#
# 실행: ./mvnw spring-boot:run -Ddotenv.filename=.env.dev
# (dev 프로파일이 자리표를 쓰지 않는 현재 구조에선 참고용. 자리표로 바꾸면 자동 반영)

# --- Database (PostgreSQL, 로컬) ---
DB_URL=jdbc:postgresql://localhost:5438/daily
DB_USERNAME=daily
DB_PASSWORD=daily

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
