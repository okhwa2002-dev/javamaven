    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.env.*)",
      "Read(./config/database.yml)",
      "Read(./config/settings.local.php)",
      "Read(./**/Web.config)",
      "Read(./**/App.config)",
      "Read(./**/connection.properties)",
